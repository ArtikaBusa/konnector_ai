<!DOCTYPE html>
<html>
  <head>
    <title>Konnector.ai Student</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body class="bg-gray-100 min-h-screen flex">
    <!-- Sidebar -->
    <aside class="w-64 bg-indigo-700 text-white flex flex-col">
      <div class="p-6 text-2xl font-bold border-b border-indigo-600">
        Konnector.ai
      </div>

      <nav class="flex-1 p-4 space-y-2">
        <%= link_to "Dashboard", student_root_path,
          class: "block px-4 py-2 rounded hover:bg-indigo-600" %>

          <%= link_to "Batches",
    student_batches_path,
    class: "block px-4 py-2 text-white hover:bg-indigo-700" %>

      </nav>

      <div class="p-4 border-t border-indigo-600 text-sm">
        Logged in as <strong>Student</strong>
      </div>

      <div class="p-4">
        <%= button_to "Logout",
          destroy_user_session_path,
          method: :delete,
          class: "bg-red-600 text-white px-3 py-1 rounded w-full" %>
      </div>
    </aside>

    <!-- Main content -->
    <main class="flex-1 p-8">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
