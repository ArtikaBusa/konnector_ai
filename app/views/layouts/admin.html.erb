<!DOCTYPE html>
<html>
  <head>
    <title>KonnectorAI Admin</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body class="bg-gray-100 min-h-screen flex">
    <!-- Sidebar -->
    <aside class="w-64 bg-indigo-700 text-white flex flex-col">
      <div class="p-6 text-2xl font-bold border-b border-indigo-600">
        Konnector.ai
      </div>

      <nav class="flex-1 p-4 space-y-2">
        <% if current_user.admin? %>

          <%= link_to "Dashboard", admin_dashboard_path,
                class: "block px-4 py-2 rounded hover:bg-indigo-600" %>

          <%= link_to "Schools", admin_schools_path,
                class: "block px-4 py-2 rounded hover:bg-indigo-600" %>

        <% elsif current_user.school_admin? %>

          <%= link_to "Dashboard", school_admin_courses_path,
                class: "block px-4 py-2 rounded hover:bg-indigo-600" %>

          <%= link_to "Courses", school_admin_courses_path,
                class: "block px-4 py-2 rounded hover:bg-indigo-600" %>

          <% if current_user.school.present? %>
            <% course = current_user.school.courses.first %>

            <% if course.present? %>
              <%= link_to "Batches",
                    school_admin_course_batches_path(course),
                    class: "block px-4 py-2 rounded hover:bg-indigo-600" %>
            <% end %>
          <% end %>

          <%= link_to "Enrollments", school_admin_enrollments_path,
                class: "block px-4 py-2 rounded hover:bg-indigo-600" %>

        <% end %>
      </nav>

      <div class="p-4 border-t border-indigo-600 space-y-2">
        <%= button_to "Logout",
              destroy_user_session_path,
              method: :delete,
              class: "w-full text-sm bg-red-600 text-white px-3 py-2 rounded" %>

        <div class="text-xs">
          Logged in as <strong><%= current_user.role %></strong>
        </div>
      </div>
    </aside>

    <!-- Main content -->
    <main class="flex-1 p-8">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
