<div class="flex justify-between items-center mb-6">
  <h2 class="text-2xl font-semibold text-gray-800">
    Schools
  </h2>

  <%= link_to "New School",
      new_admin_school_path,
      class: "bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700 transition" %>
</div>

<div class="bg-white shadow rounded-lg overflow-hidden">
  <table class="w-full text-left">
    <thead class="bg-gray-50 border-b">
      <tr>
        <th class="px-6 py-3 text-sm font-medium text-gray-600">Name</th>
        <th class="px-6 py-3 text-sm font-medium text-gray-600">Address</th>
        <th class="px-6 py-3 text-sm font-medium text-gray-600">Actions</th>
      </tr>
    </thead>

    <tbody>
      <% @schools.each do |school| %>
        <tr class="border-b hover:bg-gray-50">
          <td class="px-6 py-4 font-medium text-gray-800">
            <%= school.name %>
          </td>
          <td class="px-6 py-4 text-gray-600">
            <%= school.address %>
          </td>
          <td class="px-6 py-4 space-x-3">
            <%= link_to "Edit",
                edit_admin_school_path(school),
                class: "text-indigo-600 hover:underline" %>

            <%= button_to "Delete",
              admin_school_path(school),
              method: :delete,
              form: {
                onsubmit: "return confirm('Are you sure you want to delete this school?')"
              },
              class: "text-red-600 hover:underline bg-transparent border-none p-0" %>

          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
