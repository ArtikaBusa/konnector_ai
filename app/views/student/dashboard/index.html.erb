<h1 class="text-2xl font-semibold mb-6">Student Dashboard</h1>

<% if @enrollments.present? %>
  <table class="w-full bg-white shadow rounded">
    <thead class="bg-gray-100">
      <tr>
        <th class="p-3 text-left">Batch</th>
        <th class="p-3 text-left">Status</th>
      </tr>
    </thead>
    <tbody>
      <% @enrollments.each do |enrollment| %>
        <tr class="border-t">
          <td class="p-3"><%= enrollment.batch.name %></td>
          <td class="p-3 capitalize"><%= enrollment.status %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="bg-white p-6 rounded shadow">
    You are not enrolled in any batch yet.
  </div>
<% end %>
