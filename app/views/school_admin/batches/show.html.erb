<h1 class="text-xl font-semibold mb-4">
  Batch: <%= @batch.name %>
</h1>

<div class="mb-6 p-4 bg-white rounded shadow max-w-md">
  <h2 class="font-semibold mb-2">Add Student</h2>

  <% if @students.any? %>
      <%= form_with url: add_student_school_admin_course_batch_path(@course, @batch),
                method: :post,
                local: true do %>

      <%= select_tag :student_id,
          options_from_collection_for_select(@students, :id, :name),
          prompt: "Select student" %>

      <%= submit_tag "Add" %>
    <% end %>
  <% else %>
    <p class="text-gray-500 text-sm">
      No available students to add.
    </p>
  <% end %>
</div>

<hr class="my-6">

<h2 class="font-semibold mb-2">Enrolled Students</h2>

<ul class="list-disc pl-6">
  <% @batch.users.each do |student| %>
    <li><%= student.email %></li>
  <% end %>
</ul>
