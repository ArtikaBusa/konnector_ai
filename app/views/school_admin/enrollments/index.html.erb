<h1 class="text-2xl font-semibold mb-6">Enrollment Requests</h1>

<% if @enrollments.any? %>
  <table class="w-full bg-white shadow rounded-lg border border-gray-200">
    <thead class="bg-gray-100">
      <tr>
        <th class="p-3 text-left">Student</th>
        <th class="p-3 text-left">Batch</th>
        <th class="p-3 text-left">Status</th>
        <th class="p-3 text-left">Actions</th>
      </tr>
    </thead>

    <tbody>
      <% @enrollments.each do |enrollment| %>
        <tr class="border-t">
          <td class="p-3"><%= enrollment.user.name %></td>
          <td class="p-3"><%= enrollment.batch.name %></td>

          <!-- Status -->
          <td class="p-3">
            <% if enrollment.pending_status? %>
              <span class="px-2 py-1 text-xs rounded bg-yellow-100 text-yellow-800">
                Pending
              </span>
            <% elsif enrollment.approved_status? %>
              <span class="px-2 py-1 text-xs rounded bg-green-100 text-green-800">
                Approved
              </span>
            <% else %>
              <span class="px-2 py-1 text-xs rounded bg-red-100 text-red-800">
                Rejected
              </span>
            <% end %>
          </td>

          <!-- Actions -->
          <td class="p-3">
            <% if enrollment.pending_status? %>
              <%= button_to "Approve",
                approve_school_admin_enrollment_path(enrollment),
                method: :patch,
                class: "px-3 py-1 bg-green-600 rounded text-sm" %>

              <%= button_to "Reject",
                reject_school_admin_enrollment_path(enrollment),
                method: :patch,
                class: "px-3 py-1 bg-red-600 rounded text-sm ml-2" %>
            <% else %>
              <span class="text-gray-400 italic text-sm">No actions</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="bg-white p-6 text-gray-500 rounded shadow">
    No enrollment requests found.
  </div>
<% end %>
