<h1 class="text-2xl font-semibold mb-4">Courses</h1>

<%= link_to "New Course",
            new_school_admin_course_path,
            class: "bg-indigo-600 text-white px-4 py-2 rounded" %>

<table class="w-full mt-4 bg-white shadow rounded">
  <thead class="bg-gray-100">
    <tr>
      <th class="p-2 text-left">Name</th>
      <th class="p-2">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @courses.each do |course| %>
      <tr class="border-t">
        <td class="p-2"><%= course.name %></td>
        <td class="p-2 space-x-2">
          <%= link_to "Edit", edit_school_admin_course_path(course), class: "text-indigo-600" %>
          <%= button_to "Delete",
                        school_admin_course_path(course),
                        method: :delete,
                        data: { turbo_confirm: "Delete this course?" },
                        class: "text-red-600 bg-transparent border-none inline" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
